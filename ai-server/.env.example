# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# API Security
AI_SERVER_API_KEY=your_secure_api_key_here

# Admin Dashboard Password (for /admin-dashboard login)
ADMIN_DASHBOARD_PASSWORD=your_dashboard_password_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# =============================================================================
# ATLASSIAN OAUTH CONFIGURATION (for Desktop App Authentication)
# =============================================================================
# These secrets are now on the server only - removed from desktop app for security
ATLASSIAN_CLIENT_ID=your_atlassian_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret

# Dashboard React App — must match the ATLASSIAN_CLIENT_ID above
# Used at build time by the React app (CRA injects REACT_APP_ vars)
REACT_APP_ATLASSIAN_CLIENT_ID=your_atlassian_client_id

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Portkey AI Gateway — handles load balance + cross-provider fallback (Gemini,
# OpenAI, etc.) via the saved Config referenced by PORTKEY_CONFIG_ID.
# -----------------------------------------------------------------------------
USE_PORTKEY=true
PORTKEY_API_KEY=pk-your-portkey-api-key
# Config ID from Portkey dashboard (Configs section) — handles routing.
# When set, routing is fully managed by the saved config (no virtual key slug needed in model name).
PORTKEY_CONFIG_ID=pc-your-config-id
# Model name — overridden by the config's override_params.model, kept as a fallback hint.
PORTKEY_MODEL=gemini-2.0-flash

# =============================================================================
# AI FEATURE FLAGS
# =============================================================================
# Use AI for activity record analysis (set to 'false' to disable text-only LLM matching for activity records)
USE_AI_FOR_ACTIVITIES=true

# Minimum confidence score for AI issue matching (0.0-1.0). Below this, records stay unassigned.
# Records above threshold go through human-in-the-loop approval before syncing to Jira.
# The prompt defines 0.2-0.3 as "Weak match", 0.4-0.5 as "Reasonable". Default 0.4 rejects weak matches.
AI_MATCH_MIN_CONFIDENCE=0.4

# BRD Processing Configuration
AUTO_CREATE_JIRA_ISSUES=false

# =============================================================================
# FEEDBACK SYSTEM (User Feedback -> AI -> Jira Ticket)
# =============================================================================
# All feedback tickets are created on a SINGLE Jira instance using a
# dedicated API token. This ensures tickets from all users (across all
# Jira instances) land in one place for the development team to triage.
#
# To set up:
# 1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Create an API token for your Atlassian account
# 3. Create a Jira project (e.g., key=FEEDBACK) for feedback tickets
# 4. Note: API tokens expire after 1 year - you'll need to rotate them

# Jira project key where feedback tickets will be created
JIRA_FEEDBACK_PROJECT=FEEDBACK

# Your Jira site URL (e.g., https://timetracker.atlassian.net)
JIRA_FEEDBACK_SITE_URL=https://timetracker.atlassian.net

# Atlassian account email (the account that will create the tickets)
JIRA_FEEDBACK_EMAIL=your-email@company.com

# Atlassian API token (from https://id.atlassian.com/manage-profile/security/api-tokens)
# Note: Tokens expire after 1 year - set a reminder to rotate
JIRA_FEEDBACK_API_TOKEN=your-api-token-here

# Forge App Integration (for creating worklogs and issues)
FORGE_APP_URL=https://your-forge-app-url
FORGE_API_KEY=your_forge_api_key

# Forge Remote Authentication (FIT Token Validation)
# REQUIRED: App ID(s) to validate incoming requests from the Forge app
# Get this from your Forge app's manifest.yml or Atlassian Developer Console
# For multiple apps (dev + prod) sharing the same server, separate with commas:
FORGE_APP_ID=ari:cloud:ecosystem::app/dev-app-id,ari:cloud:ecosystem::app/prod-app-id

# Optional: Google Cloud Vision API (alternative to Tesseract for better OCR)
# GOOGLE_VISION_API_KEY=your_google_vision_api_key

# =============================================================================
# LOG SANITIZATION (PII Protection)
# =============================================================================
# Automatically redacts sensitive information from logs before they are written.
# Protects: emails, UUIDs, account IDs, IPs, JWT tokens, API keys

# Enable/disable log sanitization (default: true)
LOG_SANITIZE_ENABLED=true

# Sanitization level:
# - minimal: Only PII (emails, credit cards, phone numbers, JWT tokens, API keys)
# - standard: PII + UUIDs + Atlassian IDs + IP addresses (recommended)
# - strict: All patterns including infrastructure IDs (sheet IDs, config IDs)
LOG_SANITIZE_LEVEL=standard

# Enable audit tracking of redactions (logs count of redactions per type)
LOG_SANITIZE_AUDIT=false

# =============================================================================
# PRIVACY FILTER (OCR Data Sanitization - Delivered to Desktop App)
# =============================================================================
# These settings control the desktop app's privacy filter, which detects and
# redacts sensitive data (passwords, API keys, PII) from OCR text before it is
# uploaded to Supabase or sent to AI analysis.
# Settings are delivered to the desktop app via POST /api/auth/ocr-config.
# =============================================================================

# Master toggle for privacy filtering (default: true)
PRIVACY_FILTER_ENABLED=true

# Enable Presidio PII detection - credit cards, SSN, phone numbers (default: true)
# Requires presidio-analyzer on the desktop app (included in requirements.txt)
PRIVACY_DETECT_PII=true

# Enable custom pattern detection - passwords, API keys, tokens (default: true)
PRIVACY_DETECT_CUSTOM_PATTERNS=true

# Minimum confidence threshold for redaction, 0.0-1.0 (default: 0.7)
PRIVACY_MIN_CONFIDENCE=0.7

# Redaction strategy: mask, entity_type, hash, remove (default: mask)
PRIVACY_REDACTION_STRATEGY=mask

# Secure failure mode: if false, redact on error; if true, pass through (default: false)
PRIVACY_FAIL_OPEN=false

ADMIN_DASHBOARD_PASSWORD=Adminadmin123

# =============================================================================
# AI ACCURACY TRACKING DASHBOARD — REMOVABLE LAYER
# =============================================================================
# Allowlist is stored exclusively in public.accuracy_dashboard_users (managed
# via SQL). The dashboard is surfaced inside the Forge app frontend and gated
# by that table; no env var is required here.
#
# To grant access:
#   INSERT INTO public.accuracy_dashboard_users (email, added_by, notes)
#   VALUES ('person@company.com', 'admin@company.com', 'reason');
#
# Note: event CAPTURE (writes to ai_accuracy_events) is controlled on the
# FORGE runtime, not here, because the helper code runs inside Forge:
#   forge variables set ACCURACY_TRACKING_ENABLED false
# Capture is enabled by default if that variable is unset. See
# plan/AI_ACCURACY_TRACKING_IMPLEMENTATION_PLAN.md for the full removal procedure.
