{
  "name": "brd-automate-time-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "BRD Automation & Time Tracker for Jira",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:settings",
    "build:main": "cd static/main && npm run build",
    "build:settings": "cd static/settings && npm run build",
    "deploy": "forge deploy",
    "install-app": "forge install",
    "tunnel": "forge tunnel",
    "dev": "npm run build && forge tunnel --port 3000",
    "dev:local": "LOCAL_DEV_MODE=true FORGE_ENVIRONMENT=local npm run dev",
    "dev:macos": "MACOS_ENVIRONMENT=true LOCAL_DEV_MODE=true FORGE_ENVIRONMENT=local npm run dev",
    "setup:local": "npm install && npm run build && echo 'Local development setup complete'",
    "logs": "forge logs",
    "status": "forge status"
  },
  "keywords": [
    "jira",
    "forge",
    "time-tracking",
    "brd",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@forge/api": "^7.0.2",
    "@forge/resolver": "^1.5.0",
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@forge/cli": "^10.13.6"
  }
}
