{
  "name": "brd-automate-time-tracker",
  "version": "1.0.0",
  "description": "BRD Automation & Time Tracker for Jira",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:settings && npm run build:uim",
    "build:main": "cd static/main && npm run build",
    "build:settings": "cd static/settings && npm run build",
    "build:uim": "cd static/uim && npm run build",
    "deploy": "forge deploy",
    "install-app": "forge install",
    "tunnel": "forge tunnel",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "jira",
    "forge",
    "time-tracking",
    "brd",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@forge/api": "^7.1.2",
    "@forge/kvs": "^1.4.0",
    "@forge/resolver": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@forge/cli": "^10.13.6",
    "babel-jest": "^29.7.0",
    "caniuse-lite": "^1.0.30001782",
    "jest": "^29.7.0",
    "react-scripts": "^0.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/tests/playwright/",
      "<rootDir>/tests/e2e/",
      "<rootDir>/tests/services/workAssignmentService.test.js",
      "<rootDir>/tests/resolvers/convertUnassignedToWorklog.integration.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  }
}
