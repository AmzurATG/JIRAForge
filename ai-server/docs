## 🚀 Usage Example

```javascript
// Simple usage in any module
const mailService = require('./services/mail');

// Send password reset email
const result = await mailService.send({
  to: 'user@example.com',
  subject: 'Password Reset Request',
  html: '<p>Click <a href="https://...">here</a> to reset.</p>',
  text: 'Click here to reset: https://...',
});

if (result.success) {
  console.log(`✅ Email sent via ${result.provider}`);
  console.log(`   Message ID: ${result.messageId}`);
} else {
  console.error(`❌ Failed: ${result.error}`);
}

// Batch sending
const results = await mailService.sendBatch([
  { to: 'user1@example.com', subject: 'Report', html: '...' },
  { to: 'user2@example.com', subject: 'Report', html: '...' },
]);

console.log(`Sent ${results.filter(r => r.success).length}/${results.length}`);

// Health check
const health = await mailService.verifyProviders();
console.log('SendGrid:', health.providers.sendgrid.available ? '✅' : '❌');
console.log('Resend:', health.providers.resend.available ? '✅' : '❌');
```

