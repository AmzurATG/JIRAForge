#!/bin/bash
# =============================================================================
# AppRun – AppImage entry point for TimeTracker
#
# Called by the AppImage runtime immediately after mounting the squashfs.
# Sets up the runtime environment and launches the PyInstaller onefile binary.
# =============================================================================

# Resolve the directory that contains this AppRun script.
# readlink -f resolves symlinks so $HERE is always the real AppDir root.
HERE="$(dirname "$(readlink -f "${0}")")"

# --- Library path setup -------------------------------------------------------
# The PyInstaller onefile binary extracts itself to $TMPDIR/_MEIxxxxxx and
# manages its own library paths internally.  We only need to tell glibc where
# to find any system libraries that were NOT bundled (e.g. GTK / AppIndicator
# typelibs needed by the tray backend).
#
# Add the AppDir lib dirs first so bundled libs take precedence over system libs
# if we later switch to onedir packaging.
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/$(uname -m)-linux-gnu:${LD_LIBRARY_PATH}"

# --- GI typelib path ----------------------------------------------------------
# pystray's AppIndicator/Ayatana backend needs GObject-Introspection typelibs.
# On Wayland, AyatanaAppIndicator3 (D-Bus SNI) must be preferred over
# AppIndicator3 (X11 XEmbed, invisible on Wayland/GNOME).  List the Ayatana
# typelib directory FIRST so gi finds AyatanaAppIndicator3 before AppIndicator3.
#
# Typelib locations on Ubuntu:
#   AyatanaAppIndicator3: /usr/lib/$(arch)-linux-gnu/girepository-1.0/
#   AppIndicator3:        /usr/lib/girepository-1.0/
export GI_TYPELIB_PATH="${HERE}/usr/lib/girepository-1.0:/usr/lib/$(uname -m)-linux-gnu/girepository-1.0:/usr/lib/girepository-1.0:${GI_TYPELIB_PATH}"

# --- GStreamer plugin path ----------------------------------------------------
# CRITICAL: GStreamer needs access to system plugins (especially pipewiresrc)
# for ScreenCast Portal screenshot capture. Without this, GStreamer can't find
# pipewiresrc and falls back to Screenshot Portal which causes permission
# dialogs on every window switch (the "flash" issue).
#
# Set GST_PLUGIN_SYSTEM_PATH to include:
#   1. Bundled plugins in AppDir (if any)
#   2. System plugins (where pipewiresrc lives)
#
# GST_PLUGIN_SYSTEM_PATH is preferred over GST_PLUGIN_PATH because it allows
# GStreamer to still use its default plugin discovery while adding our paths.
export GST_PLUGIN_SYSTEM_PATH="${HERE}/usr/lib/gstreamer-1.0:/usr/lib/$(uname -m)-linux-gnu/gstreamer-1.0:/usr/lib/gstreamer-1.0:${GST_PLUGIN_SYSTEM_PATH}"

# --- Wayland / GTK display backend -------------------------------------------
# On Wayland, GTK3 apps launched from an AppImage need GDK_BACKEND set so
# AppIndicator3's GTK widgets can connect to the compositor.  Setting it to
# 'x11' uses XWayland (always available on Ubuntu) which libappindicator3
# requires for the status icon socket.  AyatanaAppIndicator3 uses pure D-Bus
# SNI and ignores GDK_BACKEND entirely.
if [ "${XDG_SESSION_TYPE}" = "wayland" ] && [ -z "${GDK_BACKEND}" ]; then
    export GDK_BACKEND=x11
fi

# --- Python path --------------------------------------------------------------
# Not needed for a onefile build – PyInstaller bundles Python entirely.
# Kept as a placeholder for future onedir migration.
# export PYTHONPATH="${HERE}/usr/lib/python3:${PYTHONPATH}"

# --- Tray backend selection --------------------------------------------------
# Leave PYSTRAY_BACKEND unset here so the Linux tray bootstrap inside the app
# can detect AppIndicator3/AyatanaAppIndicator3 and set the best backend.
# If AppIndicator is unavailable the bootstrap falls back to the xorg backend.
# Only force xorg if the caller explicitly requests it via the env var.
# (No-op block kept as documentation placeholder.)

# --- Launch the app -----------------------------------------------------------
exec "${HERE}/usr/bin/TimeTracker" "$@"
